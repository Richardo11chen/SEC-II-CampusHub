{
  "name": "campushub-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["shared", "service-a"],
  "scripts": {
    "dev": "npm run dev -w service-a",
    "dev:a": "npm run dev -w service-a",
    "build": "npm run build -w shared && npm run build -w service-a",
